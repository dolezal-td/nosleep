#!/bin/zsh
# nosleep — dočasně zakáže uspání Macu i se zavřeným víkem (clamshell mód).
# Use-case: ovládáš Mac na dálku (třeba Claude Code z mobilu) a nechceš,
# aby ti usnul, jakmile zavřeš víko a odejdeš.
#
# Jediná věc, kterou skript mění, je systémový přepínač SleepDisabled
# (pmset disablesleep). Žádný démon, žádná session, žádný běžící proces —
# jen pojistka (nosleep on 3h) si na pozadí odpočítává čas.

VERZE="2.0.0"

# Soubor s tokenem běžící pojistky. Nový on/off token přepíše nebo smaže,
# čímž starou pojistku zneplatní — nikdy nesoupeří dva časovače.
# /tmp se maže při restartu, stejně jako časovače samotné.
TOKEN_SOUBOR="/tmp/nosleep-pojistka-$(id -u)"

napoveda() {
  cat <<'EOF'
nosleep — nechá Mac vzhůru i se zavřeným víkem

Použití:
  nosleep            přepne stav (on ↔ off)
  nosleep on         zakáže uspání
  nosleep on 3h      zakáže uspání, po 3 hodinách samo obnoví (pojistka)
  nosleep off        obnoví normální uspávání (a zruší běžící pojistku)
  nosleep status     vypíše aktuální stav
  nosleep version    vypíše verzi

Délku pojistky lze psát jako 3h, 90m nebo holé sekundy (10800).
EOF
}

# Přečte aktuální stav: SleepDisabled je 0 (normál) nebo 1 (uspání zakázáno).
stav() { pmset -g | awk '/SleepDisabled/ {print $2}'; }

# Převede 3h / 90m / 7200 na sekundy. Vstup už je zvalidovaný.
na_sekundy() {
  case "$1" in
    *h) echo $(( ${1%h} * 3600 )) ;;
    *m) echo $(( ${1%m} * 60 )) ;;
    *)  echo "$1" ;;
  esac
}

zapni() {
  # Validace délky dřív, než se cokoli stane. Pouští dál jen 3h / 90m / 10800.
  # Bez ní by neplatný vstup doputoval do root shellu níže a pojistka
  # by tiše selhala (a uspávání se nikdy neobnovilo).
  if [ -n "$1" ] && ! [[ "$1" =~ '^[0-9]+[hm]?$' ]]; then
    echo "Neplatná délka: $1 — použij třeba 3h, 90m nebo 10800 (sekundy)."
    exit 1
  fi

  sudo pmset -a disablesleep 1 || exit 1
  rm -f "$TOKEN_SOUBOR"   # případná stará pojistka tímto přestává platit
  echo "🔒 Uspávání ZAKÁZÁNO — Mac zůstane vzhůru i se zavřeným víkem."

  if [ -n "$1" ]; then
    sekundy=$(na_sekundy "$1")
    token="$$.$RANDOM"
    konec=$(date -v "+${sekundy}S" "+%H:%M")
    print -r -- "$token"  > "$TOKEN_SOUBOR"
    print -r -- "$konec" >> "$TOKEN_SOUBOR"

    # Časovač před akcí ověří, že jeho token pořád platí — novější
    # on/off ho zneplatnil, takže starší pojistka nic nepřepíše.
    kontrola="[ \"\$(head -n1 '$TOKEN_SOUBOR' 2>/dev/null)\" = '$token' ] || exit 0"

    if sudo -n true 2>/dev/null; then
      # sudo teď heslo nechce (právě jsi ho zadal) → časovač poběží celý
      # pod rootem, takže mu za pár hodin nevyprší sudo oprávnění.
      sudo nohup zsh -c "sleep $sekundy; $kontrola; pmset -a disablesleep 0; rm -f '$TOKEN_SOUBOR'" >/dev/null 2>&1 &!
    elif sudo -n pmset -a disablesleep 1 >/dev/null 2>&1; then
      # sudo heslo chce, ale pmset má NOPASSWD výjimku (viz README,
      # vzdálené ovládání) → časovač poběží jako uživatel a zavolá
      # jen ten jeden povolený příkaz.
      nohup zsh -c "sleep $sekundy; $kontrola; sudo -n pmset -a disablesleep 0; rm -f '$TOKEN_SOUBOR'" >/dev/null 2>&1 &!
    else
      rm -f "$TOKEN_SOUBOR"
      echo "⚠️  Pojistku nelze naplánovat: sudo bude za $1 znovu chtít heslo."
      echo "   Uspávání zůstává zakázané — vrať ho pak ručně: nosleep off"
      return 0
    fi
    echo "⏲  Pojistka: v $konec (za $1) se uspávání samo obnoví."
  fi
}

vypni() {
  sudo pmset -a disablesleep 0 || exit 1
  rm -f "$TOKEN_SOUBOR"   # zruší i případnou běžící pojistku
  echo "🌙 Uspávání OBNOVENO — Mac usíná normálně."
}

case "$1" in
  on)     zapni "$2" ;;
  off)    vypni ;;
  status)
    if [ "$(stav)" = "1" ]; then
      echo "🔒 Uspávání je zakázáno (clamshell mód aktivní)."
      if [ -f "$TOKEN_SOUBOR" ]; then
        echo "⏲  Pojistka běží: obnova v $(sed -n '2p' "$TOKEN_SOUBOR")."
      fi
    else
      echo "🌙 Uspávání je normální."
    fi
    ;;
  version) echo "nosleep $VERZE" ;;
  -h|--help|help) napoveda ;;
  "")  # bez argumentu = přepni
    if [ "$(stav)" = "1" ]; then vypni; else zapni; fi
    ;;
  *)
    echo "Neznámý příkaz: $1"
    napoveda
    exit 1
    ;;
esac
